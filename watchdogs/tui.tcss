Screen {
    background: #0a0e14;
    color: #c8d0d8;
}

#header-bar {
    height: 3;
    background: #071018;
    color: #00e5ff;
    padding: 0 1;
    border-bottom: solid #125566;
}

#top {
    height: 12;
}

.panel {
    border: solid #1c3a4a;
    background: #0a0e14;
    padding: 0 1;
}

.panel-title {
    color: #00e5ff;
    text-style: bold;
    height: 1;
}

#sessions-panel {
    width: 2fr;
}

#alerts-panel {
    width: 3fr;
}

#logins-panel {
    height: 1fr;
}

#commands-panel {
    height: 1fr;
}

#sessions {
    color: #c8d0d8;
}

OptionList {
    background: #0a0e14;
    color: #ffd27a;
    border: none;
}

OptionList:focus {
    border: none;
}

OptionList > .option-list--option-highlighted {
    background: #1a2a22;
    color: #fff4c2;
}

RichLog {
    background: #0a0e14;
    color: #c8d0d8;
    border: none;
    scrollbar-color: #125566;
}

DataTable {
    background: #0a0e14;
    color: #c8d0d8;
    border: none;
    scrollbar-color: #125566;
    height: 1fr;
}

DataTable > .datatable--header {
    color: #00e5ff;
    text-style: bold;
    background: #071018;
}

DataTable > .datatable--cursor {
    background: #1a2a22;
    color: #fff4c2;
}

Footer {
    background: #071018;
    color: #7aa8b3;
}

SettingsScreen {
    align: center middle;
    background: rgba(4, 8, 12, 0.72);
}

ConnectScreen {
    align: center middle;
    background: rgba(4, 8, 12, 0.72);
}

#connect-box {
    width: 86;
    max-width: 100%;
    height: auto;
    max-height: 94%;
    background: #071018;
    border: solid #00e5ff;
    padding: 1 2;
}

#connect-title {
    color: #00e5ff;
    text-style: bold;
}

#connect-lead, #pick-lead, #dash-steps, #server-steps {
    color: #7aa8b3;
    margin: 0 0 1 0;
    height: auto;
}

#connect-code {
    color: #00e5ff;
    text-style: bold;
    text-align: center;
    margin: 1 0;
    height: auto;
}

#dash-addrs {
    color: #c8d0d8;
    margin: 0 0 1 0;
    height: auto;
}

#dash-wait {
    color: #00e5ff;
    margin-bottom: 1;
}

#connect-addrs {
    color: #c8d0d8;
    margin-bottom: 1;
}

#connect-status {
    color: #ffb000;
    height: 2;
    margin-top: 1;
}

#view-pick, #view-dashboard, #view-server {
    height: auto;
}

#view-pick Button {
    width: 100%;
    margin: 0 0 1 0;
}

#nearby {
    height: 7;
    background: #0a0e14;
    border: solid #1c3a4a;
    margin: 0 0 1 0;
}

#connect-after, #server-actions {
    height: 3;
    align: left middle;
    margin-top: 1;
}

#connect-after Button, #server-actions Button {
    margin-right: 1;
}

#settings-box {
    width: 92;
    max-width: 100%;
    height: auto;
    max-height: 92%;
    background: #071018;
    border: solid #00e5ff;
    padding: 1 2;
}

#settings-title {
    color: #00e5ff;
    text-style: bold;
}

#settings-role {
    color: #7aa8b3;
    margin-bottom: 1;
}

#settings-form {
    height: 1fr;
    max-height: 28;
}

.section-title {
    color: #00e5ff;
    text-style: bold;
    margin: 1 0 1 0;
}

.field {
    height: auto;
    margin-bottom: 0;
}

.field-label {
    width: 16;
    color: #7aa8b3;
    padding-top: 1;
}

.inline-label {
    width: auto;
    color: #7aa8b3;
    padding: 1 1 0 1;
}

.field-hint {
    color: #4d5d66;
    margin: 0 0 1 16;
}

.switch-row {
    height: auto;
    margin: 1 0;
}

.switch-label {
    width: auto;
    color: #c8d0d8;
    padding-top: 1;
    margin-right: 1;
}

#settings-status {
    color: #ffb000;
    height: 2;
    margin-top: 1;
}

#settings-actions {
    height: 3;
    align: left middle;
}

#settings-actions Button {
    margin-right: 1;
}

Input {
    background: #0a0e14;
    border: solid #1c3a4a;
}

Input:focus {
    border: solid #00e5ff;
}

Switch {
    margin: 0 2 0 0;
}
