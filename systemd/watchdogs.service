[Unit]
Description=WatchDogs host monitor (headless logger)
After=network.target systemd-journald.service

[Service]
Type=simple
# Install the package first: pip install /path/to/WatchDogs
# Connect once from the dashboard (`sudo python -m watchdogs`, then Join
# or Open dashboard). Headless reuses that saved link.
# ExecStart=/usr/bin/watchdogs --headless -c /etc/watchdogs/config.yaml
ExecStart=/usr/bin/watchdogs --headless -c /etc/watchdogs/config.yaml
Restart=on-failure
RestartSec=3
User=root
Nice=5

[Install]
WantedBy=multi-user.target
