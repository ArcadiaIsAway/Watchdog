[Unit]
Description=WatchDogs host agent
After=network.target systemd-journald.service

[Service]
Type=simple
# Installed automatically after the server joins from the dashboard.
# ExecStart is rewritten to the venv python and saved config.yaml.
ExecStart=/usr/bin/watchdogs --headless -c /etc/watchdogs/config.yaml
Restart=always
RestartSec=3
User=root
Nice=5
Environment=WATCHDOGS_AGENT=1

[Install]
WantedBy=multi-user.target
